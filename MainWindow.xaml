<Window x:Class="RabusaBSIT301LongQuiz.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:RabusaBSIT301LongQuiz"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid>
        <StackPanel Orientation ="Horizontal" Height="35" VerticalAlignment="Top">
            <Button Content="Page 1" MinWidth="100" Height="35" Margin="10, 0, 0, 0" Click="BtnClickP1"/>
            <Button Content="Page 2" MinWidth="100" Height="35" Margin="10, 0, 0, 0" Click="BtnClickP2"/>
            <Button Content="Page 3" MinWidth="100" Height="35" Margin="10, 0, 0, 0" Click="BtnClickP3"/>
            <Button Content="Page 4" MinWidth="100" Height="35" Margin="10, 0, 0, 0" Click="BtnClickP4"/>
        </StackPanel>
        <Menu Grid.Row="0">
            <MenuItem Header="_File">
                <MenuItem Header="Exit"
                  Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="_Navigate" Click="MenuItem_Click">
                <MenuItem Header="Page 1"
                  Click="BtnClickP1"/>
                <MenuItem Header="Page 2"
                  Click="BtnClickP2"/>
                <MenuItem Header="Page 3"
                  Click="BtnClickP3"/>
                <MenuItem Header="Page 4"
                  Click="BtnClickP4"/>
            </MenuItem>
        </Menu>
        <Frame x:Name="Main" Margin="0, 35, 0, 0" NavigationUIVisibility="Hidden"/>
    </Grid>
</Window>
